{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/jsx/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nrwl/web:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "buildableProjectDepsInPackageJsonType": "dependencies",
        "updateBuildableProjectDepsInPackageJson": true,
        "outputPath": "dist/libs/jsx",
        "tsConfig": "libs/jsx/tsconfig.lib.json",
        "project": "libs/jsx/package.json",
        "entryFile": "libs/jsx/src/index.ts",
        "external": [
          "react/jsx",
          "@emotion/react",
          "@soperio/core",
          "@soperio/theming",
          "@soperio/utils",
          "tslib"
        ],
        "rollupConfig": "@nrwl/react/plugins/bundle-rollup",
        "format": [
          "esm",
          "cjs"
        ],
        "assets": [
          {
            "glob": "libs/jsx/README.md",
            "input": ".",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/jsx/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/libs/jsx"],
      "options": {
        "jestConfig": "libs/jsx/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "deploy": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public"
      }
    }
  }
}
